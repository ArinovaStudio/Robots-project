          "request": {
            "method": "POST",
            "header": [{ "key": "Cookie", "value": "{{sessionCookie}}", "type": "text" }],
            "body": { "mode": "formdata", "formdata": [{ "key": "username", "value": "testuser", "type": "text" }, { "key": "email", "value": "test@example.com", "type": "text" }, { "key": "reason", "value": "Testing", "type": "text" }, { "key": "accountUsage", "value": "PERSONAL", "type": "text" }, { "key": "accountType", "value": "INDIVIDUAL", "type": "text" }, { "key": "declaration", "value": "true", "type": "text" }] },
            "url": { "raw": "{{baseUrl}}/api/verification", "host": ["{{baseUrl}}"], "path": ["api", "verification"] }
          }
