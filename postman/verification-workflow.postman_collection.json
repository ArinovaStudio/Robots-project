          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));", "pm.test('success is false', () => { pm.expect(pm.response.json().success).to.be.false; });"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [{ "key": "fullName", "value": "Test User", "type": "text" }] },
            "url": { "raw": "{{baseUrl}}/api/verification", "host": ["{{baseUrl}}"], "path": ["api", "verification"] }
          }
        },
        {
          "name": "POST submit — SUCCESS ✅ (attach idDocument file!)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Application submitted', () => {", "    const body = pm.response.json();", "    pm.expect(body.success).to.be.true;", "    pm.expect(body.message).to.match(/submitted successfully/i);", "    pm.expect(body.data).to.have.property('id');", "    pm.expect(body.data.status).to.equal('PENDING');", "    pm.collectionVariables.set('applicationId', body.data.id);", "    console.log('Saved applicationId:', body.data.id);", "});"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Cookie", "value": "{{sessionCookie}}", "type": "text" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "fullName", "value": "Test User", "type": "text" },
                { "key": "username", "value": "testuser123", "type": "text" },
                { "key": "email", "value": "test@example.com", "type": "text" },
                { "key": "phone", "value": "+91 98765 43210", "type": "text" },
                { "key": "dob", "value": "1995-06-15", "type": "text" },
                { "key": "location", "value": "Mumbai, India", "type": "text" },
                { "key": "reason", "value": "I want to be verified to build trust with my connections on the platform.", "type": "text" },
                { "key": "accountUsage", "value": "RECRUITING", "type": "text" },
                { "key": "accountType", "value": "INDIVIDUAL", "type": "text" },
                { "key": "additionalInfo", "value": "Software engineer with 5+ years of experience.", "type": "text" },
                { "key": "socialLinks", "value": "[\"https://linkedin.com/in/testuser\"]", "type": "text" },
                { "key": "declaration", "value": "true", "type": "text" },
                { "key": "idDocument", "description": "⚠️ REQUIRED: Attach a real PDF/JPG/PNG under 10MB", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/verification", "host": ["{{baseUrl}}"], "path": ["api", "verification"] },
            "description": "⚠️ Attach a real file to the `idDocument` field before sending.\nThis saves the applicationId to the collection variable for admin tests."
          }
        }
      ]
