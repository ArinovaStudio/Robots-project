          "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}", "type": "text" }], "url": { "raw": "{{baseUrl}}/api/admin/verifications?status=VERIFIED", "host": ["{{baseUrl}}"], "path": ["api", "admin", "verifications"], "query": [{ "key": "status", "value": "VERIFIED" }] } }
