          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/admin/verifications", "host": ["{{baseUrl}}"], "path": ["api", "admin", "verifications"] } }
        },
        {
          "name": "GET verifications — default list",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Has data + stats + pagination', () => {", "    const body = pm.response.json();", "    pm.expect(body.success).to.be.true;", "    pm.expect(body.data).to.be.an('array');", "    pm.expect(body.stats).to.have.all.keys('total','pending','approved','rejected','infoRequired');", "    pm.expect(body.pagination.page).to.equal(1);", "    pm.expect(body.pagination.limit).to.equal(10);", "    if (body.data.length > 0 && !pm.collectionVariables.get('applicationId')) {", "        pm.collectionVariables.set('applicationId', body.data[0].id);", "    }", "});"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}", "type": "text" }], "url": { "raw": "{{baseUrl}}/api/admin/verifications", "host": ["{{baseUrl}}"], "path": ["api", "admin", "verifications"] } }
        },
        {
          "name": "GET verifications — status=PENDING",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('All items are PENDING', () => {", "    const body = pm.response.json();", "    pm.expect(body.success).to.be.true;", "    body.data.forEach(app => pm.expect(app.status).to.equal('PENDING'));", "});"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}", "type": "text" }], "url": { "raw": "{{baseUrl}}/api/admin/verifications?status=PENDING", "host": ["{{baseUrl}}"], "path": ["api", "admin", "verifications"], "query": [{ "key": "status", "value": "PENDING" }] } }
        },
