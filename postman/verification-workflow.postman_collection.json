{
  "info": {
    "name": "Robots Project — Verification Workflow",
    "_postman_id": "robots-verification-workflow",
    "description": "Full E2E tests for the verification workflow.\n\nFolders:\n1. User: Get Verification Status\n2. User: Submit Verification Application\n3. Admin: List All Applications\n4. Admin: Get Single Application\n5. Admin: Add Internal Note\n6. Admin: Actions (Approve / Reject / More Info)\n7. Verify DB State After Actions\n\nSetup: Import this file AND the companion environment file.\nMake sure your dev server is running on http://localhost:3000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "applicationId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01 — User: Get Verification Status",
      "item": [
        {
          "name": "GET verification status (authenticated user)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('success is true', () => {", "    const body = pm.response.json();", "    pm.expect(body.success).to.be.true;", "    pm.expect(body.data).to.have.property('id');", "    pm.expect(body.data).to.have.property('verificationStatus');", "});", "const body = pm.response.json();", "if (body.data && body.data.verificationApplication) {", "    pm.collectionVariables.set('applicationId', body.data.verificationApplication.id);", "}"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "{{sessionCookie}}", "type": "text" }], "url": { "raw": "{{baseUrl}}/api/verification", "host": ["{{baseUrl}}"], "path": ["api", "verification"] } }
        },
        {
          "name": "GET verification status (no auth) → 401",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));", "pm.test('success is false', () => { pm.expect(pm.response.json().success).to.be.false; });"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/verification", "host": ["{{baseUrl}}"], "path": ["api", "verification"] } }
        }
      ]
    },
    {
