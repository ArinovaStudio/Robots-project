          "request": { "method": "GET", "header": [{ "key": "Cookie", "value": "{{adminSessionCookie}}", "type": "text" }], "url": { "raw": "{{baseUrl}}/api/admin/verifications?sort=oldest&page=1&limit=5&search=test", "host": ["{{baseUrl}}"], "path": ["api", "admin", "verifications"], "query": [{ "key": "sort", "value": "oldest" }, { "key": "page", "value": "1" }, { "key": "limit", "value": "5" }, { "key": "search", "value": "test" }] } }
