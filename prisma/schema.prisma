generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [vector]
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  BUSINESS
  INVESTOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  MORE_INFO_REQUIRED
}

model User {
  id String @id @default(uuid())
  name String?
  email String? @unique
  password String?
  emailVerified DateTime?
  image String?
  role Role @default(USER)
  accountType AccountType @default(BUSINESS)
  status UserStatus @default(ACTIVE)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  isOnboarded Boolean @default(false)
  notificationsSeenAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  company CompanyProfile?
  investor InvestorProfile?
  verificationApplication VerificationApplication?
  followers Follow[] @relation("Followers")
  following Follow[] @relation("Following")
  sentConnections Connection[] @relation("SentConnections")
  receivedConnections Connection[] @relation("ReceivedConnections")
  subscriptions Subscription[]
  transactions Transaction[]
  posts Post[]
  comments Comment[]
  postReactions PostReaction[]
  commentReactions CommentReaction[]
  savedPosts SavedPost[]
  hiddenPosts HiddenPost[]
  conversationsAsUser1 Conversation[] @relation("ConversationUser1")
  conversationsAsUser2 Conversation[] @relation("ConversationUser2")
  sentMessages DirectMessage[] @relation("MessageSender")
  submittedReports PostReport[]
  hiddenCompanies HiddenCompany[] @relation("HiddenCompanyOwner")
  hiddenByUsers HiddenCompany[] @relation("HiddenCompanyTarget")
  submittedCompanyReports CompanyReport[] @relation("CompanyReporter")
  companyReports CompanyReport[] @relation("CompanyReported")
  notifications Notification[]
  collaborationRequests CollaborationRequest[]
  postBusinessIntents PostBusinessIntent[]
  sentMarketplaceCollaborations MarketplaceCollaboration[] @relation("CollabRequester")
  receivedMarketplaceCollaborations MarketplaceCollaboration[] @relation("CollabRecipient")
  companyPitches CompanyPitch[]
  pitchViews CompanyPitchView[] @relation("InvestorPitchViews")
  pitchOffers CompanyPitchOffer[] @relation("InvestorPitchOffers")
  pitchRatings CompanyPitchRating[] @relation("InvestorPitchRatings")
  sentPitchRequests PitchRequest[] @relation("PitchRequestSender")
  receivedPitchRequests PitchRequest[] @relation("PitchRequestInvestor")
}

model VerificationApplication {
  id String @id @default(uuid())
  userId String @unique
  fullName String
  username String
  email String
  phone String?
  dob String?
  location String?

  reason String @db.Text
  accountUsage String @db.Text
  accountType String
  additionalInfo String? @db.Text

  socialLinks String[]

  idDocumentUrl String
  idDocumentName String

  supportingDocUrl String?
  supportingDocName String?

  status VerificationStatus @default(PENDING)
  rejectionReason String?
  infoRequestMessage String? @db.Text
  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  history VerificationHistory[]
  adminNotes VerificationAdminNote[]
}

model VerificationHistory {
  id String @id @default(uuid())
  applicationId String
  action String
  previousStatus VerificationStatus?
  newStatus VerificationStatus
  message String? @db.Text
  performedBy String?
  createdAt DateTime @default(now())

  application VerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model VerificationAdminNote {
  id String @id @default(uuid())
  applicationId String
  note String @db.Text
  authorId String
  authorName String?
  createdAt DateTime @default(now())

  application VerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Account {
  id String @id @default(uuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}


model CompanyProfile {
  id String @id @default(uuid())
  userId String @unique
  companyName String
  description String @db.Text
  logoUrl String?
  bannerUrl String?
  size Int
  type String
  yearOfEstablishment Int
  dealIn String[]
  website String?  
  location String?
  lookingFor String[]
  offeringVector Unsupported("vector(768)")?
  needsVector Unsupported("vector(768)")?
  isBoosted Boolean @default(false)

  exchangeDataset Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileViews ProfileViewStat[]
  impressions SearchImpressionStat[]
}

model InvestorProfile {
  id String @id @default(uuid())
  userId String @unique
  investorType String
  firmName String?
  bannerUrl String?
  openTo String[] @default([])
  phone String?
  country String?
  city String?
  currentDesignation String?
  currentCompany String?
  entityLegalName String?
  entityType String?
  registrationNumber String?
  registeredCountry String?
  officialWebsite String?
  representativeName String?
  representativeDesignation String?
  typicalInvestmentAmount String?
  totalCapitalAvailable String?
  currency String?
  investmentFrequency String?
  expectedTimeline String?
  sourceOfFunds String?
  canProvideFinancialEvidence Boolean @default(false)
  hasPreviousInvestments Boolean @default(false)
  previousInvestmentCount Int?
  previousStartups String[] @default([])
  previousInvestmentRange String?
  industriesInvested String[] @default([])
  yearsExperience Int?
  portfolioUrl String?
  references String?
  sectors String[]
  stages String[]
  investmentRange String
  location String?
  website String?
  linkedInUrl String?
  locations String[] @default([])
  investmentStructures String[] @default([])
  ownershipPreference String?
  investorRole String?
  mentorshipInterest Boolean @default(false)
  investmentThesis String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum OtpType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model Otp {
  id String @id @default(cuid())
  email String
  otp String
  type OtpType
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, type]) 
}

model Follow {
  id String @id @default(uuid())
  followerId String
  followingId String
  createdAt DateTime @default(now())

  follower User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Connection {
  id String @id @default(uuid())
  senderId String
  receiverId String
  status ConnectionStatus @default(PENDING)
  message String? @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender User @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model Plan {
  id String @id @default(uuid())
  name String
  description String?
  price Float
  duration Int
  isActive Boolean @default(true)
  givesBoost Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  transactions Transaction[]
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

model Subscription {
  id String @id @default(uuid())
  userId String
  planId String
  status SubscriptionStatus @default(ACTIVE)
  
  startDate DateTime @default(now())
  endDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model Transaction {
  id String @id @default(uuid())
  userId String
  planId String
  amount Float
  currency String @default("INR")
  razorpayOrderId String @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?
  status TransactionStatus @default(PENDING)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum PostStatus {
  ACTIVE
  SUSPENDED
}

enum PostVisibility {
  ANYONE
  CONNECTIONS
}

enum CommentAccess {
  ANYONE
  CONNECTIONS
}

model Post {
  id String @id @default(uuid())
  authorId String
  content String? @db.Text
  status PostStatus @default(ACTIVE)
  isEdited Boolean @default(false)
  visibility PostVisibility @default(ANYONE)
  commentAccess CommentAccess @default(ANYONE)
  repostOfId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  repostOf Post? @relation("PostReposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts Post[] @relation("PostReposts")
  media PostMedia[]
  event PostEvent?
  comments Comment[]
  reactions PostReaction[]
  savedBy SavedPost[]
  hiddenBy HiddenPost[]
  reports PostReport[]
  businessIntent PostBusinessIntent?

  @@index([repostOfId])
}

model PostEvent {
  id String @id @default(uuid())
  postId String @unique
  title String
  date DateTime
  location String?
  link String?
  
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostMedia {
  id String @id @default(uuid())
  postId String
  url String
  type MediaType
  
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Comment {
  id String @id @default(uuid())
  postId String
  authorId String
  content String @db.Text
  isEdited Boolean @default(false)
  
  parentId String?     
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
  reactions CommentReaction[]
}

enum ReactionType {
  LIKE
  DISLIKE
  CELEBRATE
  SUPPORT
  LOVE
  INSIGHTFUL
  FUNNY
}

model PostReaction {
  id String @id @default(uuid())
  postId String
  userId String
  type ReactionType
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId]) 
  @@index([postId, type, createdAt])
}

model CommentReaction {
  id String @id @default(uuid())
  commentId String
  userId String
  type ReactionType

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId]) 
}

model SavedPost {
  id String @id @default(uuid())
  userId String
  postId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model HiddenPost {
  id String @id @default(uuid())
  userId String
  postId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Conversation {
  id String @id @default(uuid())
  user1Id String
  user2Id String
  lastMessage String? @db.Text
  lastMessageAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1 User @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([user1Id, user2Id]) 
}

model DirectMessage {
  id String @id @default(uuid())
  conversationId String
  senderId String
  content String @db.Text
  mediaUrl String?
  mediaType String?
  isEdited Boolean @default(false)
  isRead Boolean @default(false)
  isDeleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
}

enum ReportReason {
  SPAM
  NUDITY_OR_SEXUAL_CONTENT
  HATE_SPEECH
  HARASSMENT
  VIOLENCE
  COPYRIGHT_VIOLATION
  OTHER
}

enum ReportStatus {
  PENDING
  ACTION_TAKEN 
  DISMISSED
}

model PostReport {
  id String @id @default(uuid())
  postId String
  userId String
  reason ReportReason
  details String? @db.Text
  status ReportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId]) 
}

model HiddenCompany {
  id String @id @default(uuid())
  userId String
  companyUserId String
  createdAt DateTime @default(now())

  user User @relation("HiddenCompanyOwner", fields: [userId], references: [id], onDelete: Cascade)
  company User @relation("HiddenCompanyTarget", fields: [companyUserId], references: [id], onDelete: Cascade)

  @@unique([userId, companyUserId])
}

model CompanyReport {
  id String @id @default(uuid())
  companyUserId String
  userId String
  reason ReportReason
  details String? @db.Text
  status ReportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company User @relation("CompanyReported", fields: [companyUserId], references: [id], onDelete: Cascade)
  user User @relation("CompanyReporter", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyUserId, userId])
}

model SearchStat {
  id String @id @default(uuid())
  query String   
  isTag Boolean @default(false)
  date DateTime @db.Date
  count Int @default(1)

  @@unique([query, date, isTag])
}

model ProfileViewStat {
  id String @id @default(uuid())
  companyId String   
  date DateTime @db.Date
  count Int @default(1)

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  @@unique([companyId, date])
}

model SearchImpressionStat {
  id String @id @default(uuid())
  companyId String 
  date DateTime @db.Date
  count Int @default(1)

  company CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  @@unique([companyId, date])
}

enum NotificationType {
  NEW_MESSAGE
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  POST_LIKE
  NEW_COMMENT
  SYSTEM
  MENTION
  NETWORK_ACTIVITY
  INVESTOR_OFFER
}

model Notification {
  id String @id @default(uuid())
  userId String
  actorId String?
  type NotificationType
  content String
  link String?
  isRead Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
   @@index([userId, createdAt])
}

enum CollabStatus {
  OPEN
  CLOSED
}

model CollaborationRequest {
  id String @id @default(uuid())
  title String
  description String @db.Text
  authorId String
  status CollabStatus @default(OPEN)
  tags String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model PostBusinessIntent {
  id String @id @default(uuid())
  postId String @unique
  authorId String
  isBusinessIntent Boolean @default(false)
  intentType String?
  category String?
  services String[] @default([])
  industry String?
  confidence Float?
  rawAnalysis Json?
  embedding Unsupported("vector(768)")?
  status String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([intentType])
  @@index([status])
}

model CompanyPitch {
  id String @id @default(uuid())
  userId String
  title String
  tagline String?
  type String @default("PITCH")
  summary String @db.Text
  sector String
  stage String @default("Seed")
  targetAmount String?
  equityOffered String?
  highlights Json @default("[]")
  pitchDeckUrl String?
  websiteUrl String?
  status String @default("ACTIVE")
  isSharedWithCompanies Boolean @default(false)
  feedPostId String?
  collabRequestId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  owner User @relation(fields: [userId], references: [id], onDelete: Cascade)
  views CompanyPitchView[]
  offers CompanyPitchOffer[]
  ratings CompanyPitchRating[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model CompanyPitchView {
  id String @id @default(uuid())
  pitchId String
  investorId String
  createdAt DateTime @default(now())

  pitch CompanyPitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  investor User @relation("InvestorPitchViews", fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([pitchId, investorId])
  @@index([investorId])
}

model CompanyPitchOffer {
  id String @id @default(uuid())
  pitchId String
  investorId String
  amount String
  amountValue Float
  terms String
  message String? @db.Text
  status String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  pitch CompanyPitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  investor User @relation("InvestorPitchOffers", fields: [investorId], references: [id], onDelete: Cascade)

  @@index([pitchId, createdAt])
  @@index([investorId, createdAt])
}

model CompanyPitchRating {
  id String @id @default(uuid())
  pitchId String
  investorId String
  rating Int
  feedback String? @db.Text
  createdAt DateTime @default(now())

  pitch CompanyPitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  investor User @relation("InvestorPitchRatings", fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([pitchId, investorId])
  @@index([investorId, createdAt])
}

model MarketplaceCollaboration {
  id String @id @default(uuid())
  requesterId String
  recipientId String
  expectations String[] @default([])
  offerings String[] @default([])
  contributionDesc String? @db.Text
  resourcesAvailable String? @db.Text
  expertiseCapabilities String? @db.Text
  existingAssets String? @db.Text
  overview String @db.Text
  status String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester User @relation("CollabRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("CollabRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([recipientId])
  @@index([status])
}

// A business asking a specific investor to review their pitch (B2I collaboration)
model PitchRequest {
  id String @id @default(uuid())
  senderId String
  investorId String
  companyName String
  problemStatement String @db.Text
  proposedSolution String @db.Text
  fundingRequirement String
  equityOffered String?
  message String @db.Text
  pitchDeckUrl String
  status String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender User @relation("PitchRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  investor User @relation("PitchRequestInvestor", fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId, createdAt])
  @@index([senderId, investorId, status])
}
